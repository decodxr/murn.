MURN_OLLAMA_URL=http://127.0.0.1:11434
MURN_OLLAMA_MODEL=llama3.1:8b
MURN_EMBEDDING_MODEL=embeddinggemma

# Editable personality/system prompt. murn. reads this file again on every message,
# so editing it takes effect on the next reply without restarting the backend.
MURN_SYSTEM_PROMPT_PATH=prompts/system.md

# Public internet research. web_open blocks localhost/private-network targets.
MURN_WEB_ENABLED=true
MURN_WEB_MAX_RESULTS=6
MURN_WEB_OPEN_MAX_CHARS=12000
MURN_WEB_TIMEOUT_SECONDS=15

# Orbital/Chromium browser control through Chrome DevTools Protocol.
# Keep this bound to loopback only; CDP can control your logged-in browser session.
MURN_BROWSER_ENABLED=true
MURN_ORBITAL_URL=http://127.0.0.1:9222
MURN_BROWSER_TIMEOUT_SECONDS=12
MURN_BROWSER_SNAPSHOT_MAX_CHARS=12000
MURN_BROWSER_SNAPSHOT_MAX_ELEMENTS=120

# Local image understanding through Ollama.
# qwen2.5vl:3b is a good default for an 8 GB GPU.
MURN_VISION_MODEL=qwen2.5vl:3b
MURN_VISION_MAX_MB=20

# Point this at the root of your Obsidian vault.
MURN_OBSIDIAN_VAULT=/home/you/Documents/Obsidian/MyVault
MURN_OBSIDIAN_MEMORY_DIR=murn

MURN_COMFYUI_URL=http://127.0.0.1:8188
MURN_COMFY_WORKFLOW_PATH=workflows/txt2img_api.json

# Node IDs from the ComfyUI API-format workflow.
MURN_COMFY_POSITIVE_NODE=
MURN_COMFY_NEGATIVE_NODE=
MURN_COMFY_SEED_NODE=
MURN_COMFY_LATENT_NODE=

# Persistent local state.
MURN_DATA_DIR=.murn
MURN_SESSION_DB_NAME=sessions.db
MURN_SEMANTIC_DB_NAME=memory_embeddings.db

# Local speech-to-text (whisper.cpp). Input is normalized through ffmpeg.
MURN_WHISPER_CLI=/home/you/AI/whisper.cpp/build/bin/whisper-cli
MURN_WHISPER_MODEL=/home/you/AI/whisper.cpp/models/ggml-base.bin
MURN_WHISPER_LANGUAGE=auto
MURN_WHISPER_NO_GPU=false
MURN_FFMPEG_BIN=ffmpeg

# Local text-to-speech (Piper). Install murn.'s voice extra and download this voice.
MURN_PIPER_MODEL=/home/you/.local/share/murn/voices/pt_BR-faber-medium.onnx
MURN_AUDIO_MAX_MB=25

MURN_AGENT_MAX_STEPS=12
